# Application Settings
ENVIRONMENT=development
PROJECT_NAME="BuildLog API"
DEBUG=True

# Database Configuration
# Defaults to SQLite for instant local development.
# For PostgreSQL (Neon / Render), set your connection string:
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./buildlog.db

# Security & Authentication (Milestone 4)
SECRET_KEY=dev-insecure-secret-key-change-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Frontend URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
