# Application Settings
ENVIRONMENT=development
PROJECT_NAME="BuildLog API"
DEBUG=True

# Database Configuration
# Defaults to SQLite for instant local development.
# For PostgreSQL (Neon / Render), set your connection string:
# DATABASE_URL=postgresql://user:password@ep-xyz.neon.tech/neondb?sslmode=require
DATABASE_URL=sqlite:///./buildlog.db

# Security & Authentication (Milestone 4)
SECRET_KEY=dev-insecure-secret-key-change-in-production-use-openssl-rand-hex-32
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS Origins (Frontend URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- GitHub OAuth ("Continue with GitHub") ----------
# Create an OAuth App at https://github.com/settings/developers
# Homepage URL:            http://localhost:5173   (local)  | https://buiildlogg.netlify.app (prod)
# Authorization callback:  http://localhost:8000/api/auth/github/callback   (local)
#                          https://buildlog-zab9.onrender.com/api/auth/github/callback (prod)
# Leave CLIENT_ID/SECRET empty to disable the GitHub button.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Full callback URL registered on GitHub (empty = derive from request, fine locally)
GITHUB_REDIRECT_URI=
# Where the backend sends the browser after a successful GitHub login
FRONTEND_URL=http://localhost:5173
